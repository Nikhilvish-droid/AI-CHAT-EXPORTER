    "from reportlab.lib.pagesizes import A4\nfrom reportlab.platypus import SimpleDocTemplate, Paragraph, Spacer, Image\nfrom reportlab.lib.styles import getSampleStyleSheet, ParagraphStyle\nfrom reportlab.lib.units import inch\nfrom reportlab.lib.enums import TA_CENTER\nfrom reportlab.lib.utils import ImageReader\nfrom pathlib import Path\n\npdf_path = \"/mnt/data/Flowers_Description.pdf\"\nimage_path = \"/mnt/data/a_crisp_high_resolution_close_up_macro_photograph.png\"\n\nstyles = getSampleStyleSheet()\ntitle_style = ParagraphStyle(\n    \"TitleCustom\", parent=styles[\"Title\"], alignment=TA_CENTER,\n    fontSize=24, spaceAfter=16\n)\nheading_style = ParagraphStyle(\n    \"HeadingCustom\", parent=styles[\"Heading2\"], fontSize=14,\n    spaceBefore=8, spaceAfter=6\n)\nbody_style = ParagraphStyle(\n    \"BodyCustom\", parent=styles[\"BodyText\"], fontSize=11,\n    leading=17, spaceAfter=8\n)\n\ndoc = SimpleDocTemplate(\n    pdf_path, pagesize=A4,\n    rightMargin=55, leftMargin=55, topMargin=45, bottomMargin=45\n)\n\nstory = [\n    Paragraph(\"Flowers\", title_style),\n    Image(image_path, width=4.8*inch, height=3.6*inch),\n    Spacer(1, 14),\n    Paragraph(\"1. Beauty and Nature\", heading_style),\n    Paragraph(\"Flowers are one of the most beautiful parts of nature. They come in many shapes, sizes, and colors, making gardens and surroundings look attractive.\", body_style),\n    Paragraph(\"2. Reproduction in Plants\", heading_style),\n    Paragraph(\"Flowers play an important role in the reproduction of flowering plants. They help plants produce seeds through processes such as pollination.\", body_style),\n    Paragraph(\"3. Importance to the Environment\", heading_style),\n    Paragraph(\"Flowers provide nectar and pollen for bees, butterflies, birds, and other pollinators. In this way, they support biodiversity and healthy ecosystems.\", body_style),\n    Paragraph(\"4. Uses of Flowers\", heading_style),\n    Paragraph(\"Flowers are used for decoration, festivals, à¤ªà¥à¤à¤¾ and cultural celebrations, perfumes, medicines, and sometimes in food. Different flowers have different traditional and practical uses.\", body_style),\n    Paragraph(\"5. Symbol of Emotions\", heading_style),\n    Paragraph(\"Flowers are often used to express feelings such as love, friendship, respect, happiness, and sympathy. For this reason, they are commonly given as gifts on special occasions.\", body_style),\n]\n\ndoc.build(story)\n\nprint(f\"Created: {pdf_path}\")\n",
