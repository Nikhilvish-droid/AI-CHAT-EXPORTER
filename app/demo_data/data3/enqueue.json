97,"_221":298,"_204":299,"_191":300,"_133":301,"_81":302},"current_node","0e26d03c-4262-4e56-8b59-93bfd5625226","og_title","og_description","is_public","linear_conversation",[119,120,121,122,123,124,125,126,127,128],"has_user_editable_context","highlighted_message_id","continue_conversation_url","https://chatgpt.com/share/6a92d202-b690-83e8-9f5e-3336dedb286c/continue","model",{"_109":110,"_111":112,"_53":113,"_114":115,"_116":117},"moderation_state",{"_104":14,"_105":14,"_106":14,"_107":14,"_108":14},"is_indexable","is_better_metatags_enabled","backing_conversation_id","6a92d1b3-3e70-83ee-a075-3a9b30c8a1d5","og_image_variant","response_multicolor_v1","x_metadata_policy","is_potion_share","citron_only","has_been_moderated","has_been_blocked","has_been_accepted","has_been_auto_blocked","has_been_auto_moderated","slug","gpt-5-6","max_tokens",34834,"GPT-5.6 Luna","description","Our latest and most advanced model","tags",[118],"history_off_approved",{"_129":280,"_134":292},{"_129":270,"_130":279,"_132":280,"_134":281},{"_129":260,"_130":269,"_132":270,"_134":271},{"_129":251,"_130":259,"_132":260,"_134":261},{"_129":240,"_130":250,"_132":251,"_134":252},{"_129":221,"_130":239,"_132":240,"_134":241},{"_129":204,"_130":220,"_132":221,"_134":222},{"_129":191,"_130":203,"_132":204,"_134":205},{"_129":133,"_130":190,"_132":191,"_134":192},{"_129":81,"_130":131,"_132":133,"_134":135},"id","message",{"_129":81,"_136":137,"_54":138,"_56":139,"_140":141,"_142":143,"_144":34,"_145":146,"_147":148,"_149":150,"_151":152},"parent","b3a0d6ab-18a7-47d7-b307-469dabecbe03","children",[],"author",{"_187":188,"_147":189},1788006891.56013,1788006895.658561,"content",{"_182":183,"_184":185},"status","finished_successfully","end_turn","weight",1,"metadata",{"_153":154,"_155":34,"_156":157,"_158":159,"_160":161,"_162":110,"_163":164,"_165":166,"_167":168,"_169":170,"_171":172,"_173":172,"_174":110,"_66":67,"_175":34,"_176":133,"_177":10},"recipient","all","channel","final","finish_details",{"_50":178,"_179":180},"is_complete","citations",[],"content_references",[],"story_events",[],"resolved_model_slug","search_result_groups",[],"cot_version","v5","request_id","d2b9bb1f-7de2-43b2-b63f-8fbafb0521e8","message_type","next","turn_exchange_id","dad43e0f-4b5f-4643-8817-3f6281ffe4d7","working_turn_id","model_slug","can_save","parent_id","shared_conversation_id","stop","stop_tokens",[181],200002,"content_type","text","parts",[186],"**Cosine similarity** is a method used to measure **how similar two vectors are based on the angle between them**. In RAG, text is converted into **embeddings (vectors)**, and cosine similarity helps find which stored text is most similar to the user's query.\n\n- **Similarity = 1** → vectors are exactly in the same direction → very similar.\n- **Similarity = 0** → vectors are perpendicular → little/no similarity.\n- **Similarity = -1** → vectors point in opposite directions → very different.\n- Formula:\n\n  \\[\n  \\text{Cosine Similarity} = \\frac{A \\cdot B}{\\|A\\|\\|B\\|}\n  \\]\n\n- **Example in RAG:**\n  - Query: `\"How can I reset my password?\"`\n  - Document 1: `\"Steps to reset your account password\"` → **high similarity**\n  - Document 2: `\"Today's weather is cloudy\"` → **low similarity**\n  - RAG retrieves Document 1 and sends it to the LLM to generate the answer.\n\nSo, simply: **Cosine similarity tells us how close two embeddings are in meaning/direction.**","role","assistant",{},{"_129":133,"_136":193,"_54":194,"_140":195,"_142":143,"_145":196,"_147":197,"_149":150},"c5087467-3bb7-4506-9b13-4f0197f2b5bf",[81],{"_187":201,"_147":202},1788006891.560674,{"_182":183,"_184":199},0,{"_165":166,"_167":168,"_169":170,"_171":172,"_173":172,"_174":110,"_66":67,"_176":191,"_177":10,"_198":34,"_175":14},"is_visually_hidden_from_conversation",[200],"","system",{},{"_129":191,"_136":206,"_54":207,"_56":208,"_140":209,"_142":143,"_145":146,"_147":210,"_149":150},"b64b19dd-7926-4643-8629-b7ce9eeab428",[133],{"_187":218,"_147":219},1788006890.073,1788006895.98039,{"_182":183,"_184":216},{"_211":212,"_167":168,"_213":-5,"_171":172,"_173":172,"_177":10,"_175":14},"serialization_metadata",{"_214":215},"message_source","custom_symbol_offsets",[],[217],"what is cosine similarity","user",{},{"_129":204,"_136":223,"_54":224,"_56":225,"_140":226,"_142":143,"_144":34,"_145":146,"_147":227,"_149":150,"_151":152},"37b09b39-dab1-4189-8411-4412d9756d05",[191],{"_187":188,"_147":238},1788006867.816881,1788006872.808814,{"_182":183,"_184":236},{"_153":228,"_155":34,"_156":229,"_158":230,"_160":231,"_162":110,"_163":232,"_165":166,"_167":233,"_169":170,"_171":234,"_173":234,"_174":110,"_66":67,"_175":34,"_176":221,"_177":10},{"_50":178,"_179":235},[],[],[],[],"9d4afc8a-dc72-44c4-a383-23a2cc287b74","91e88229-48c1-4bca-9ff4-cd4d923b5d80",[181],[237],"### LLM vs RAG\n\n**LLM (Large Language Model)** is an AI model trained on a huge amount of data to understand and generate human-like text. It uses the knowledge learned during training to answer questions, write content, summarize, code, etc. However, its knowledge can become outdated and it may not know private or newly created information.\n\n**RAG (Retrieval-Augmented Generation)** is a technique that combines an LLM with an external knowledge source. Instead of relying only on what the LLM learned during training, RAG first **retrieves relevant information from documents, databases, or vector stores** and then gives that information to the LLM to generate an answer.\n\n- **LLM:** The actual language model.\n- **RAG:** A system/architecture that uses an LLM + external knowledge.\n- **LLM:** Relies mainly on knowledge learned during training.\n- **RAG:** Retrieves additional information at query time.\n- **LLM:** Can have outdated knowledge.\n- **RAG:** Can provide more up-to-date information if the knowledge source is updated.\n- **LLM:** Does not automatically know your private documents.\n- **RAG:** Can search your private documents and provide relevant content to the LLM.\n- **Example LLM:** GPT, Llama, Claude.\n- **Example RAG:** User asks a question → search company PDFs → retrieve relevant chunks → give chunks to LLM → LLM generates the answer.",{},{"_129":221,"_136":242,"_54":243,"_140":244,"_142":143,"_145":146,"_147":245,"_149":150},"c0a2543d-6d57-45f1-a60b-ea414756cae1",[204],{"_187":188,"_147":249},1788006867.817291,{"_182":247,"_248":200},{"_165":166,"_171":234,"_173":234,"_176":240,"_177":10,"_246":34},"is_redacted","model_editable_context","model_set_context",{},{"_129":240,"_136":253,"_54":254,"_140":255,"_142":143,"_145":146,"_147":256,"_149":150},"d7df342e-3828-47e9-b188-ad2d04efc3e5",[221],{"_187":201,"_147":258},1788006867.700768,{"_182":183,"_184":257},{"_198":34,"_165":166,"_167":233,"_169":170,"_171":234,"_173":234,"_174":110,"_66":67,"_176":251,"_177":10,"_175":14},[200],{},{"_129":251,"_136":262,"_54":263,"_140":264,"_142":143,"_144":34,"_145":196,"_147":265,"_149":150},"2ee5964a-7c72-4c5b-a70d-163b8804d3d6",[240],{"_187":201,"_147":268},1788006868.390974,{"_182":183,"_184":267},{"_266":34,"_198":34,"_165":166,"_167":233,"_169":170,"_171":234,"_173":234,"_174":110,"_66":67,"_176":260,"_177":10,"_175":14},"rebase_developer_message",[200],{},{"_129":260,"_136":272,"_54":273,"_140":274,"_142":143,"_144":34,"_145":196,"_147":275,"_149":150},"dd9f9194-3bf8-4d7b-9050-a84376ec5497",[251],{"_187":201,"_147":278},1788006868.390619,{"_182":183,"_184":277},{"_276":34,"_198":34,"_165":166,"_167":233,"_169":170,"_171":234,"_173":234,"_174":110,"_66":67,"_176":270,"_177":10,"_175":14},"rebase_system_message",[200],{},{"_129":270,"_136":282,"_54":283,"_56":284,"_140":285,"_142":143,"_145":146,"_147":286,"_149":150},"client-created-root",[260],{"_187":218,"_147":291},1788006866.47,1788006873.010521,{"_182":183,"_184":289},{"_211":287,"_167":233,"_213":-5,"_171":234,"_173":234,"_177":10,"_175":14},{"_214":288},[],[290],"what is diffrence between llm and rag and give only paragraph and points ",{},[270],{"_129":28