# Copy to backend/.env and fill in. Never commit the real .env.

# Groq API key, used by app/services/llm.py against api.groq.com
GROQ_API_KEY=

# Comma-separated origins allowed to call the API from a browser.
# Local dev: http://localhost:5173
# EC2 behind Nginx: http://<public-ip-or-domain>  (https:// once you add a certificate)
ALLOWED_ORIGINS=http://localhost:5173

# 1 = load the embedding model at startup instead of on the first request.
WARMUP_MODEL=0
