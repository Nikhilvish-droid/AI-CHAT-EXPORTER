# Backend origin (no trailing /api), baked in at build time.
# Leave empty to call /api on the same origin - the Vite dev proxy forwards it
# locally, and Nginx forwards it on the EC2 deployment (see deploy/).
# Only set it when the API lives on a different origin than the site, and then
# add the site's origin to ALLOWED_ORIGINS in backend/.env.
VITE_API_URL=
